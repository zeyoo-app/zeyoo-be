# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://zeyoo:zeyoo@localhost:5432/zeyoo?schema=public

# Redis (BullMQ + realtime)
REDIS_URL=redis://localhost:6379

# Auth — JWT signing secrets (generate strong random values per environment)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=1209600

# Stripe (payments, payouts) — from the Stripe dashboard
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
# Only if the billing endpoint (/v1/webhooks/stripe/billing) is a separate Stripe endpoint with its own secret.
STRIPE_BILLING_WEBHOOK_SECRET=
# Temporary only: simulate successful funding and run normal ledger fulfillment.
PAYMENTS_BYPASS_STRIPE=false

# Image uploads (brand logos, campaign covers) — stored in Cloudflare R2.
# Create an API token with Object Read & Write on the bucket (R2 -> Manage API tokens).
# PUBLIC_ASSET_BASE_URL is the bucket's public URL (custom domain or r2.dev), no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PUBLIC_ASSET_BASE_URL=https://cdn.example.com

# SMS — phone-number sign-in. SMS_PROVIDER=auto uses Twilio when the credentials
# below are set and otherwise logs codes to stdout (development only).
SMS_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email — verification codes and password resets. MAIL_PROVIDER=auto uses Plunk
# when PLUNK_API_KEY is set and otherwise logs codes to stdout (development only).
# The domain in MAIL_FROM must be verified in the Plunk project or sends are rejected.
MAIL_PROVIDER=auto
MAIL_FROM=Zeyoo <no-reply@zeyoo.app>
PLUNK_API_KEY=

# Extra browser origins allowed by CORS (comma-separated). APP_WEB_URL is always allowed.
CORS_ORIGINS=https://www.zeyoo.app,https://zeyoo.app

# --- View tracking (all optional; a platform without its key falls back to manual entry) ---
# YouTube Data API v3 key (public videos need only this).
YOUTUBE_API_KEY=
# X API v2 app-only bearer token.
X_BEARER_TOKEN=
# TikTok Login Kit app (creators connect their own account; scope video.list).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram API with Instagram Login app (scopes instagram_business_basic, instagram_business_manage_insights).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# YouTube (Google OAuth client with YouTube Data API v3) and Snapchat (Login Kit) account connection
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# Page on the web app that Instagram/TikTok redirect to after a creator authorises.
SOCIAL_OAUTH_REDIRECT_URI=
# 32 random bytes, base64 or hex: encrypts stored platform tokens. Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Minutes between automatic view refreshes for live campaigns; 0 disables.
VIEW_SYNC_INTERVAL_MINUTES=360
