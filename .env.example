# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://zeyoo:zeyoo@localhost:5432/zeyoo?schema=public

# Redis (BullMQ + realtime)
REDIS_URL=redis://localhost:6379

# Auth — JWT signing secrets (generate strong random values per environment)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=1209600

# Stripe (payments, payouts) — from the Stripe dashboard
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Image uploads (brand logos, campaign covers) — written to local disk and served
# from PUBLIC_ASSET_BASE_URL. Point the base URL at a CDN/bucket in production.
UPLOAD_DIR=./uploads
PUBLIC_ASSET_BASE_URL=http://localhost:3000/uploads

# SMS — phone-number sign-in. SMS_PROVIDER=auto uses Twilio when the credentials
# below are set and otherwise logs codes to stdout (development only).
SMS_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email — verification codes and password resets. MAIL_PROVIDER=auto uses Plunk
# when PLUNK_API_KEY is set and otherwise logs codes to stdout (development only).
# The domain in MAIL_FROM must be verified in the Plunk project or sends are rejected.
MAIL_PROVIDER=auto
MAIL_FROM=Zeyoo <no-reply@zeyoo.app>
PLUNK_API_KEY=
