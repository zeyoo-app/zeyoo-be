// Social ingestion module.
// Owns encrypted OAuth tokens for connected accounts and the time-series of
// metric snapshots that power dashboards and (later) fraud/predictive models.

// Where a snapshot came from: a brand member typing a count in, or a platform API read.
enum MetricSource {
  MANUAL
  PLATFORM_API
}

model SocialOAuthToken {
  id                    String         @id @default(uuid()) @db.Uuid
  creatorUserId         String         @db.Uuid
  platform              SocialPlatform
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  // The platform's id for the connected account (TikTok open_id, Instagram user id).
  externalAccountId     String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([creatorUserId, platform])
  @@map("social_oauth_tokens")
}

model MetricSnapshot {
  id            String         @id @default(uuid()) @db.Uuid
  campaignId    String         @db.Uuid
  creatorUserId String         @db.Uuid
  platform      SocialPlatform
  source        MetricSource   @default(MANUAL)
  // The submission whose post was measured; null for snapshots recorded before tracking.
  submissionId  String?        @db.Uuid
  views         Int
  likes         Int
  comments      Int
  shares        Int
  capturedAt    DateTime       @default(now())

  @@index([campaignId])
  @@index([creatorUserId])
  @@index([submissionId])
  @@map("social_metric_snapshots")
}
