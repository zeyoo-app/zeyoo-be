// Identity & Access (iam) module.
// Owns authentication, users, organizations, teams, memberships, roles, and API keys.

enum UserType {
  BRAND_USER
  CREATOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  OWNER
  MEMBER
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

// A short-lived, single-use code delivered out-of-band (email) to prove control
// of an address (email verification) or authorize a credential reset.
enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

model User {
  id     String  @id @default(uuid()) @db.Uuid
  // Nullable so an account can be created from a phone number alone. At least one
  // of email/phone is always present; a sign-in identifier is proven by either
  // emailVerifiedAt or phoneVerifiedAt.
  email String? @unique
  // Stored in E.164 form (+15551234567) so lookups are a single exact match.
  phone         String?    @unique
  type          UserType
  status        UserStatus @default(PENDING)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  credential        Credential?
  refreshTokens     RefreshToken[]
  oauthIdentities   OAuthIdentity[]
  verificationCodes VerificationCode[]
  memberships       Membership[]

  @@map("iam_users")
}

// Hashed 6-digit codes for email sign-in. Keyed by (lower-cased) email rather than
// by userId for the same reason as phone codes: the code is the first proof of
// identity for an account that does not exist yet.
model EmailVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("iam_email_verification_codes")
}

// Hashed 6-digit codes for SMS delivery. Deliberately keyed by phone rather than
// by userId, because a phone code is the first proof of identity for an account
// that does not exist yet: the row must survive (and be consumed) before the
// User it will create is ever written.
model PhoneVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("iam_phone_verification_codes")
}

// Hashed 6-digit codes for email verification and password reset. Only the hash
// is stored; codes are single-use (consumedAt) and attempt-limited to blunt
// brute force against the low-entropy 6-digit space.
model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  purpose    VerificationPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("iam_verification_codes")
}

// Password material is kept separate from User so that social-only or SSO-only
// accounts simply have no credential row.
model Credential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("iam_credentials")
}

// One row per issued refresh token. Rotation stores a hash only; a reused
// (already-rotated) token is detected via revokedAt + replacedById.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("iam_refresh_tokens")
}

model OAuthIdentity {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("iam_oauth_identities")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  website   String?
  industry  String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams       Team[]
  memberships Membership[]
  apiKeys     ApiKey[]
  campaigns   Campaign[]

  @@map("iam_organizations")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([organizationId])
  @@map("iam_teams")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  teamId         String?  @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("iam_memberships")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  prefix         String    @unique
  keyHash        String    @unique
  scopes         String[]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("iam_api_keys")
}
