// Identity & Access (iam) module.
// Owns authentication, users, organizations, teams, memberships, roles, and API keys.

enum UserType {
  BRAND_USER
  CREATOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  // The person deleted their account: identifiers and personal data are erased and
  // the row remains only so ledger and review history keep a valid owner.
  DELETED
}

enum OrgRole {
  OWNER
  MEMBER
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  // Nullable so an account can be created from a phone number alone. At least one
  // of email/phone is always present; a sign-in identifier is proven by either
  // emailVerifiedAt or phoneVerifiedAt.
  email           String?    @unique
  // Stored in E.164 form (+15551234567) so lookups are a single exact match.
  phone           String?    @unique
  type            UserType
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens   RefreshToken[]
  oauthIdentities OAuthIdentity[]
  memberships     Membership[]

  @@map("iam_users")
}

// Hashed 6-digit codes for email sign-in. Keyed by (lower-cased) email rather than
// by userId for the same reason as phone codes: the code is the first proof of
// identity for an account that does not exist yet.
model EmailVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("iam_email_verification_codes")
}

// Hashed 6-digit codes for SMS delivery. Deliberately keyed by phone rather than
// by userId, because a phone code is the first proof of identity for an account
// that does not exist yet: the row must survive (and be consumed) before the
// User it will create is ever written.
model PhoneVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("iam_phone_verification_codes")
}

// One row per issued refresh token. Rotation stores a hash only; a reused
// (already-rotated) token is detected via revokedAt + replacedById.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("iam_refresh_tokens")
}

model OAuthIdentity {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("iam_oauth_identities")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  website   String?
  industry  String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams       Team[]
  memberships Membership[]
  apiKeys     ApiKey[]
  campaigns   Campaign[]

  @@map("iam_organizations")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([organizationId])
  @@map("iam_teams")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  teamId         String?  @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("iam_memberships")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  prefix         String    @unique
  keyHash        String    @unique
  scopes         String[]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("iam_api_keys")
}

// Zeyoo staff who sign in to the back office. A separate identity from User:
// staff never need a creator or brand account, and one person can hold both under
// the same email without either affecting the other. More roles come later.
enum StaffRole {
  SUPER_ADMIN
}

enum StaffStatus {
  ACTIVE
  DEACTIVATED
}

model StaffAccount {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  role         StaffRole
  status       StaffStatus @default(ACTIVE)
  // The staff member who added this one; null for the seeded super admin.
  addedById    String?     @db.Uuid
  lastSignInAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refreshTokens StaffRefreshToken[]

  @@map("iam_staff_accounts")
}

// Back-office sign-in codes, kept apart from customer codes so a code sent for
// one can never be spent on the other.
model StaffSignInCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("iam_staff_sign_in_codes")
}

// Same rotation scheme as RefreshToken, for staff sessions.
model StaffRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  staffId      String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  staff StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("iam_staff_refresh_tokens")
}
