// Submissions module.
// Owns a creator's content submission for a campaign, its revisions, and the
// brand's review decisions.

enum SubmissionStatus {
  PENDING
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum SubmissionContentType {
  LINK
  UPLOAD
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

model Submission {
  id         String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  // The submitting creator (cross-module reference, validated in the service).
  creatorUserId String @db.Uuid

  status SubmissionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign  Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  revisions SubmissionRevision[]
  reviews   Review[]

  @@unique([campaignId, creatorUserId])
  @@index([creatorUserId])
  @@map("submissions")
}

model SubmissionRevision {
  id           String                @id @default(uuid()) @db.Uuid
  submissionId String                @db.Uuid
  contentType  SubmissionContentType
  contentUrl   String
  note         String?
  createdAt    DateTime              @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviews    Review[]
  // The published posts this version points at: at most one per campaign platform.
  // A LINK revision has at least one; an UPLOAD revision has none.
  posts      SubmissionPost[]

  @@index([submissionId])
  @@map("submission_revisions")
}

// One published post in a revision, on one of the campaign's platforms. Views are
// tracked per post, and a creator's earnings count every platform they posted on.
model SubmissionPost {
  id         String         @id @default(uuid()) @db.Uuid
  revisionId String         @db.Uuid
  platform   SocialPlatform
  url        String
  createdAt  DateTime       @default(now())

  revision SubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, platform])
  @@map("submission_posts")
}

model Review {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @db.Uuid
  revisionId   String         @db.Uuid
  // Brand user who reviewed (audit stamp).
  reviewerUserId String       @db.Uuid
  decision     ReviewDecision
  note         String?
  createdAt    DateTime       @default(now())

  submission Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  revision   SubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_reviews")
}
